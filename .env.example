# ─────────────────────────────────────────────────────────────────────────────
# BigOne Growth Lab — Environment template
# Copy to `.env` for local dev. In production, set these in your host's
# dashboard (Render → Environment), NOT in a committed file.
# NEVER commit real secrets. .env is git-ignored; this .env.example is safe.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# MUST be exactly "production" on the live site. In production this enables
# secure cookies, HSTS/upgrade-insecure-requests, the startup env guard, and
# makes reCAPTCHA fail-closed. Leaving it as "development" on deploy is unsafe.
NODE_ENV=production

# Public base URL of the live site, no trailing slash. This is used to build the
# Korapay redirect_url and notification_url (webhook) and the links in emails.
# If this is wrong (e.g. localhost), customers get redirected to the wrong host
# and webhooks are delivered nowhere. Use your real, canonical domain.
BASE_URL=https://bigonegrowthlab.store

PORT=3000

# ── Korapay (payments) ───────────────────────────────────────────────────────
# Use LIVE keys (sk_live_… / pk_live_…) in production. Test keys never move real
# money. Keep these in the host's secret store only.
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=
KORAPAY_ENCRYPTION_KEY=

# ── SMMWiz (supplier) ────────────────────────────────────────────────────────
SMMWIZ_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# Managed Postgres URL. On Render prefer the Internal Database URL (private
# network). If the password contains special characters (@ : / ? # [ ] space *),
# URL-encode them (@ -> %40, space -> %20, * -> %2A).
DATABASE_URL=

# Only relevant in production. Leave unset (encrypted-but-unverified) when using
# a private/internal DB URL. When connecting over the public internet, set to
# true AND provide DB_SSL_CA so the certificate is actually verified.
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=

# ── Email (transactional) ────────────────────────────────────────────────────
# Gmail works for low volume but caps ~500/day and risks spam/suspension.
# For production scale, switch to a transactional provider (Resend/Postmark/etc.)
# with SPF/DKIM/DMARC configured on your domain.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="BigOne Growth Lab <bigonegrowthlab@gmail.com>"

# ── Admin session ────────────────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -hex 32`). Rotating it logs admins out.
ADMIN_SESSION_SECRET=

# One-off value read by `npm run reset-admin` to set the admin password
# non-interactively. Unset it again after running.
# ADMIN_PASSWORD=

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── FX / currency ────────────────────────────────────────────────────────────
CURRENCY=GHS
# Fallback USD→GHS rate used only if the DB setting `usd_to_ghs_rate` is unset.
USD_TO_GHS=15.5
